# Шаблон окружения. Скопируйте в .env и подставьте свои значения:
#   cp .env.example .env
# Файл .env в .gitignore и в репозиторий не попадает.

POSTGRES_USER=guestbook
POSTGRES_PASSWORD=change-me
POSTGRES_DB=guestbook

# Хост базы: "localhost" при локальном запуске, "db" внутри docker compose.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
